*.epub
.DS_Store

# DailyBCI working scratch — downloaded paper figures, PIL crops, full-text
# PDFs/txt, page renders. The committed artifact is the rendered deck under
# output/ (figures are baked into the card PNGs). papers/ is regenerable and
# fully deletable, so ignore the whole dir (catch stray scripts/HTML too).
# Anchored with leading slash so it ONLY matches the root scratch dir, NOT
# the tracked knowledge-base/papers/ milestone library.
/papers/

# Python build artifacts
__pycache__/
*.pyc

# 行业热点站，独立 Git 仓库
/AIHOT-main/

# 本地参考资料：受版权保护的教材 PDF 与含他人肖像的截图，不进公开仓库
/material/*.pdf
/material/*.png

# 临时草稿目录（含付费墙论文 PDF）
/tmp/

# Office 打开文件时生成的临时锁文件
~$*
